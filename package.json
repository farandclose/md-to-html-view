{
  "name": "md-to-html-view",
  "version": "1.0.0",
  "description": "Render any Markdown file as a clean, Google-Doc-style, read-only HTML page. Zero dependencies, no build step, no network calls.",
  "bin": {
    "md-to-html-view": "skills/md-to-html-view/scripts/sync-doc-html.js",
    "md-to-html-view-watch": "skills/md-to-html-view/scripts/watch-doc-html.js"
  },
  "scripts": {
    "example": "node skills/md-to-html-view/scripts/sync-doc-html.js examples/sample.md"
  },
  "keywords": [
    "markdown",
    "html",
    "viewer",
    "renderer",
    "converter",
    "docs",
    "google-doc",
    "zero-dependencies",
    "offline"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=14"
  },
  "files": [
    "skills"
  ]
}
